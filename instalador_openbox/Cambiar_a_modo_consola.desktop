[Desktop Entry]
Version=1.0
Type=Application
Name=Pasar a Consola Pura
Comment=Apaga el entorno grafico para liberar RAM y trabajar en la terminal
Exec=bash -c 'DISPLAY=:0 notify-send "Armbian TV3S" "🛑 Apagando interfaz grafica... Liberando memoria RAM."; sleep 2; sudo systemctl isolate multi-user.target'
Icon=utilities-terminal
Terminal=false
Categories=System;Settings;
StartupNotify=false
